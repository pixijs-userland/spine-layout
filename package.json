{
    "name": "@pixijs-userland/spine-layout",
    "version": "0.4.0",
    "description": "Compose Pixi.js scenes from Spine skeletons with state/event-based animation",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pixijs-userland/spine-layout.git"
    },
    "homepage": "https://github.com/pixijs-userland/spine-layout#readme",
    "bugs": {
        "url": "https://github.com/pixijs-userland/spine-layout/issues"
    },
    "keywords": [
        "pixi",
        "pixijs",
        "spine",
        "layout",
        "animation"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src",
        "format": "prettier --write .",
        "check-types": "tsc --noEmit",
        "clean": "rm -rf dist",
        "prepublishOnly": "pnpm clean && pnpm build",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "pnpm build && changeset publish"
    },
    "peerDependencies": {
        "howler": "^2.2.4",
        "@esotericsoftware/spine-pixi-v8": "^4.3.7",
        "pixi.js": "^8.19.0"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.10",
        "@types/howler": "^2.2.12",
        "@vitest/coverage-v8": "^4.1.6",
        "eslint": "^9.25.0",
        "happy-dom": "^20.9.0",
        "typescript": "^5.8.3",
        "vitest": "^4.1.6"
    }
}
